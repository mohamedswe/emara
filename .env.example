# Copy this file to .env and fill in your key.
# The auditor uses DeepSeek for contract discovery. That is the only backend.

# Your DeepSeek API key. Never committed — .env is gitignored.
# You can also paste the raw key (sk-...) as the single line of .env.
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
